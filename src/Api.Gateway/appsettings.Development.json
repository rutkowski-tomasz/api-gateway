{
  "Gateway": {
    "Compression": {
      "Level": "Fastest"
    },
    "SecurityHeaders": {
      "Enabled": true,
      "ContentSecurityPolicy": "default-src 'none'"
    },
    "Caching": {
      "Enabled": true
    },
    "Metrics": {
      "Enabled": true
    },
    "Services": [
      {
        "Name": "api1"
      },
      {
        "Name": "api2",
        "RateLimiting": {
          "PermitLimit": 100,
          "WindowSeconds": 60
        },
        "Cors": {
          "Origins": ["http://localhost:3000", "http://localhost:5000"]
        }
      }
    ]
  }
}
